[Unit]
Description=Mini Forwarder - TCP Port Forwarding Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 用户和组
User=root
Group=root

# 二进制路径
ExecStart=/usr/local/bin/mini-forwarder -config /etc/mini-forwarder/forwarder.yaml
ExecReload=/bin/kill -HUP $MAINPID

# 重启策略
Restart=on-failure
RestartSec=5s

# 资源限制
LimitNOFILE=65535
LimitNPROC=4096

# 安全加固 (systemd >= 214)
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mini-forwarder

[Install]
WantedBy=multi-user.target
